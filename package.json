{
  "name": "mvt-viewer",
  "description": "Chrome DevTools extension: inspect Mapbox Vector Tile (MVT/.pbf) network responses as readable, interactive JSON or GeoJSON - fully offline.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "bun tests/run-tests.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "pbf": "^3.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
